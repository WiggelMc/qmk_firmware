{
    "type": "object",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "name": {
            "type": "string"
        },
        "author": {
            "type": "string"
        },
        "keyAmount": {
            "type": "number",
            "minimum": 2,
            "maximum": 16
        },
        "keyPrefix": {
            "type": "string"
        },
        "generation": {
            "type": "object",
            "properties": {
                "headerLines": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": ["headerLines"],
            "additionalProperties": false
        },
        "input": {
            "type": "object",
            "properties": {
                "uint8m": {
                    "type": "string",
                    "pattern": "^[ 0-7m\\-]+$"
                },
                "uint9": {
                    "type": "string",
                    "pattern": "^[ 0-8\\-]+$"
                }
            },
            "required": ["uint8m", "uint9"],
            "additionalProperties": false
        },
        "options": {
            "type": "object",
            "properties": {
                "tapCodeDelay": {
                    "$ref": "#/$defs/option"
                },
                "tapCodeGap": {
                    "$ref": "#/$defs/option"
                }
            },
            "required": ["tapCodeDelay", "tapCodeGap"],
            "additionalProperties": false
        },
        "specialChords": {
            "type": "object",
            "properties": {
                "noop": {
                    "$ref": "#/$defs/chordArray"
                },
                "cancel": {
                    "$ref": "#/$defs/chordArray"
                },
                "zero": {
                    "$ref": "#/$defs/chordArray"
                }
            },
            "required": ["noop", "cancel", "zero"],
            "additionalProperties": false
        },
        "chords": {
            "type": "array",
            "items": {
                "anyOf": [
                    {
                        "type": "array",
                        "prefixItems": [
                            { "$ref": "#/$defs/advancedChord" },
                            { "$ref": "#/$defs/keyExpression" },
                            { "$ref": "#/$defs/modifiers" }
                        ],
                        "minItems": 2,
                        "items": false
                    },
                    { "$ref": "#/$defs/comment" }
                ]
            }
        },
        "directKeys": {
            "type": "array",
            "items": {
                "anyOf": [
                    {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "chords": {
                                "$ref": "#/$defs/chordArray"
                            },
                            "keys": {
                                "type": "object",
                                "patternProperties": {
                                    "^Layer [0-9A-F]$": {
                                        "type": "object",
                                        "patternProperties": {
                                            "^[0-9A-F]$": {
                                                "$ref": "#/$defs/keyExpression"
                                            }
                                        },
                                        "additionalProperties": false
                                    }
                                },
                                "required": ["Layer 0"],
                                "additionalProperties": false
                            }
                        },
                        "required": ["name", "chords", "keys"],
                        "additionalProperties": false
                    },
                    { "$ref": "#/$defs/comment" }
                ]
            }
        }
    },
    "required": [
        "name",
        "author",
        "keyAmount",
        "keyPrefix",
        "generation",
        "input",
        "specialChords",
        "chords",
        "directKeys",
        "options"
    ],
    "additionalProperties": false,
    "$defs": {
        "option": {
            "type": "object",
            "properties": {
                "default": {
                    "type": "number"
                },
                "chords": {
                    "$ref": "#/$defs/chordArray"
                }
            },
            "required": ["default", "chords"],
            "additionalProperties": false
        },
        "comment": {
            "type": "string",
            "pattern": "^\\/.*$"
        },
        "chord": {
            "type": "string",
            "pattern": "^[ 01-]+$"
        },
        "advancedChord": {
            "type": "string",
            "pattern": "^[ 01scamMACS\\-]+ L[0-9A-F\\-]$"
        },
        "modifiers": {
            "type": "string",
            "pattern": "^([\\+i][ scamMACS]+)+$"
        },
        "chordArray": {
            "type": "array",
            "items": {
                "anyOf": [
                    { "$ref": "#/$defs/chord" },
                    { "$ref": "#/$defs/comment" }
                ]
            }
        },
        "keyExpression": {
            "type": "string"
        }
    }
}
